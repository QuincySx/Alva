  "command": "python3 build.py --clang /explicit/wasi-sdk-34/bin/clang --source-tar /explicit/quickjs-v0.17.0.tar.gz",
  "flags": [
    "--target=wasm32-wasip1",
    "-mexec-model=reactor",
    "-O2",
    "-DNDEBUG",
    "-D_GNU_SOURCE",
    "-D_WASI_EMULATED_SIGNAL",
    "-mno-tail-call",
    "-ffile-prefix-map=/alva-quickjs-source=/alva-quickjs-source",
    "-I",
    "/alva-quickjs-source",
    "-Wl,-z,stack-size=2097152",
    "-Wl,--initial-memory=4194304",
    "-Wl,--max-memory=67108864",
    "-Wl,--strip-all"
  ]
